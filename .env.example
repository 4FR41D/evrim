# Bu dosyayı .env olarak kopyalayıp doldurabilirsin (opsiyonel).
# Uygulama Ayarlar sekmesinden girilen anahtarları data/settings.json içinde de saklar.

PORT=3000
HOST=0.0.0.0

# AI sağlayıcı anahtarları (birini doldurman yeterli)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Anahtar girilip provider "auto" iken hangi sağlayıcının tercih edileceği
DEFAULT_PROVIDER=groq

# Verilerin saklanacağı klasör (bulut sunucuda kalıcı volume'a bağla)
# DATA_DIR=/var/data/evrim
